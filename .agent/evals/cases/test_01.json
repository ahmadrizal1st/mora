{
  "id": "test_01",
  "name": "Auth Flow - Register & Login",
  "description": "Verifikasi endpoint register dan login berfungsi dengan benar",
  "scope": "api",
  "steps": [
    {
      "action": "POST /auth/register",
      "input": {
        "name": "Test User",
        "email": "test@vistamora.id",
        "password": "password123",
        "role": "owner"
      },
      "expected": {
        "status": 201,
        "body_contains": ["user_id", "message"]
      }
    },
    {
      "action": "POST /auth/verify-otp",
      "input": {
        "email": "test@vistamora.id",
        "otp": "123456"
      },
      "expected": {
        "status": 200,
        "body_contains": ["access_token", "user"]
      }
    },
    {
      "action": "POST /auth/login",
      "input": {
        "email": "test@vistamora.id",
        "password": "password123"
      },
      "expected": {
        "status": 200,
        "body_contains": ["access_token", "user"],
        "cookies_set": ["refresh_token"]
      }
    },
    {
      "action": "GET /auth/me",
      "headers": {
        "Authorization": "Bearer {access_token}"
      },
      "expected": {
        "status": 200,
        "body_contains": ["id", "name", "email"]
      }
    },
    {
      "action": "POST /auth/logout",
      "headers": {
        "Authorization": "Bearer {access_token}"
      },
      "expected": {
        "status": 200,
        "cookies_cleared": ["refresh_token"]
      }
    }
  ]
}
