{
  "name": "file_ops",
  "description": "Operasi file dalam konteks project Vista Mora",
  "operations": ["read", "write", "edit", "delete", "list", "search"],
  "project_paths": {
    "backend": {
      "controllers": "api/app/Http/Controllers/",
      "requests": "api/app/Http/Requests/",
      "models": "api/app/Models/",
      "services": "api/app/Services/",
      "repositories": "api/app/Repositories/",
      "repository_contracts": "api/app/Repositories/Contracts/",
      "repository_eloquent": "api/app/Repositories/Eloquent/",
      "jobs": "api/app/Jobs/",
      "events": "api/app/Events/",
      "listeners": "api/app/Listeners/",
      "providers": "api/app/Providers/",
      "migrations": "api/database/migrations/",
      "seeders": "api/database/seeders/",
      "factories": "api/database/factories/",
      "routes": "api/routes/",
      "config": "api/config/",
      "tests": "api/tests/"
    },
    "frontend": {
      "core_api": "apps/core/js/src/api/",
      "core_services": "apps/core/js/src/services/",
      "core_types": "apps/core/js/src/types/",
      "shared_ui": "apps/shared/includes/ui/",
      "shared_cards": "apps/shared/includes/cards/",
      "shared_layouts": "apps/shared/includes/layouts/",
      "shared_static": "apps/shared/static/",
      "vista_pages": "apps/vista/pages/",
      "vista_js": "apps/vista/js/pages/",
      "vista_scss": "apps/vista/scss/",
      "mora_pages": "apps/mora/pages/",
      "mora_js": "apps/mora/js/pages/",
      "mora_scss": "apps/mora/scss/"
    },
    "docs": {
      "worksheet": "worksheet/",
      "agent": ".agent/"
    }
  },
  "file_extensions": {
    "backend": [".php"],
    "frontend": [".html", ".ts", ".scss", ".css", ".js"],
    "config": [".yml", ".yaml", ".json", ".env"],
    "docs": [".md"]
  },
  "ignore_patterns": [
    "vendor/",
    "node_modules/",
    ".git/",
    "storage/",
    "bootstrap/cache/"
  ]
}
