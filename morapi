#!/bin/bash
set -e

SCRIPT_PATH="$(readlink "$0" 2>/dev/null || echo "$0")"
DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

case "${1:-}" in
    run)
        shift
        exec "$DIR/script/run.sh" "$@"
        ;;
    stop)
        lsof -ti :8000 -ti :5173 -ti :8001 2>/dev/null | xargs kill -9 2>/dev/null || true
        caddy stop 2>/dev/null || true
        echo "[OK] Services stopped"
        ;;
    *)
        echo "Usage: morapi <command>"
        echo ""
        echo "Commands:"
        echo "  run [local|docker]   Start development services (default: local)"
        echo "  stop                 Stop all services"
        ;;
esac
